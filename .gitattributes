# Keep repository diffs predictable across Windows, macOS and Linux.
* text=auto eol=lf

# Windows helper scripts are intended to remain directly runnable in PowerShell.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.jar binary
