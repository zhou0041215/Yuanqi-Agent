YUANQI_JAVA_BASE_URL=http://localhost:8080
YUANQI_JAVA_MAX_RESPONSE_BYTES=12000000
YUANQI_CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# Internal model gateway. It receives the message and permission-filtered JSON Schemas,
# and returns {"toolCall":{"name":"...","arguments":{...}}}.
YUANQI_PLANNER_API_URL=
YUANQI_PLANNER_API_KEY=
YUANQI_PLANNER_MAX_RESPONSE_BYTES=1000000
# Local development fallback using Ollama native tool calling. The internal gateway above wins
# when both are configured. Never send the user's JWT to either planner.
YUANQI_PLANNER_OLLAMA_URL=
YUANQI_PLANNER_OLLAMA_MODEL=qwen3:8b
YUANQI_SANDBOX_IMAGE=yuanqi-agent-sandbox:local
YUANQI_SANDBOX_TIMEOUT_SECONDS=20
YUANQI_SANDBOX_MEMORY=512m
YUANQI_SANDBOX_CPUS=1.0
YUANQI_GRAPHRAG_ENABLED=false
# 与根目录 .env.example 的 Docker 映射端口保持一致。
YUANQI_NEO4J_URI=neo4j://localhost:17687
YUANQI_NEO4J_USERNAME=neo4j
YUANQI_NEO4J_PASSWORD=replace-with-a-strong-password
YUANQI_NEO4J_DATABASE=neo4j
YUANQI_QDRANT_URL=http://localhost:16333
YUANQI_QDRANT_COLLECTION=yuanqi_knowledge
# Production: configure an internal OpenAI-compatible semantic embedding endpoint.
# When omitted, the service uses deterministic offline embeddings for development only.
# Changing this backend (or its model/dimensions) requires rebuilding the vector
# index — index-time and query-time embeddings must share one vector space.
YUANQI_EMBEDDING_API_URL=
YUANQI_EMBEDDING_API_KEY=
YUANQI_EMBEDDING_MODEL=enterprise-embedding
YUANQI_EMBEDDING_DIMENSIONS=384
YUANQI_GRAPHRAG_TOP_K=8
YUANQI_GRAPHRAG_RRF_K=60
YUANQI_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
