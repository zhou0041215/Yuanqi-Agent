MYSQL_DATABASE=yuanqi
MYSQL_USER=yuanqi
# 仅用于本地开发；生产环境必须替换并通过密钥管理系统提供。
MYSQL_PASSWORD=yuanqi-local
MYSQL_ROOT_PASSWORD=root-local-only
# 使用非系统默认端口，避免占用本机已安装的 MySQL、Redis 等服务。
MYSQL_PORT=13306
REDIS_PORT=16379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=yuanqi
JWT_AUDIENCE=yuanqi-api
FLOWABLE_DATABASE_SCHEMA_UPDATE=false
FLOWABLE_ASYNC_EXECUTOR_ACTIVATE=false
NEO4J_PASSWORD=replace-with-a-strong-password
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
